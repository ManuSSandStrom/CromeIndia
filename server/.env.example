NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/crome-india
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional: set these when creating the first administrator with npm run create-admin -w server
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# For Render deployment, set CLIENT_URL to your Vercel frontend URL
# Multiple origins can be comma-separated
CLIENT_URL=http://localhost:5173
TRUST_PROXY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional integrations are not enabled until configured
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFICATION_EMAIL=
MEDIA_PROVIDER=
MEDIA_API_KEY=
MEDIA_API_SECRET=
